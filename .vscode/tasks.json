{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "#### [ Active Config ] # Build",
            "type": "shell",
            "windows": {
                "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-NoLogo", "-NonInteractive"] } },
                "command": "if (Test-Path .vscode/settings.json) { [IO.File]::WriteAllText((Resolve-Path .vscode/settings.json).Path, ([IO.File]::ReadAllText((Resolve-Path .vscode/settings.json).Path) -creplace '--compile-commands-dir=[^\\x22]*', ('--compile-commands-dir=' + ('${command:cpptools.activeConfigName}' -replace '^#### ', '')))) }; make -j8 -s -f makefile -C \"('${command:cpptools.activeConfigName}' -replace '^#### ', '')\" build"
            },
            "linux": {
                "command": "sed -i \"s|--compile-commands-dir=[^\\x22]*|--compile-commands-dir=$(echo \"${command:cpptools.activeConfigName}\" | sed \"s/^#### //\")|\" .vscode/settings.json 2>/dev/null || true && make -j8 -s -f makefile -C \"$(echo '${command:cpptools.activeConfigName}' | sed 's/^#### //')\" build"
            },
            "group": { "kind": "build" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["absolute"] },
            "presentation": { "showReuseMessage": false, "echo": false, "clear": false, "panel": "shared", "focus": true, "close": false }
